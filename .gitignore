# Secrets und lokale .env-Sicherungen -- nie tracken
secrets/
.env
.env-backups/

# Nur fuer lokale Testlaeufe (exponiert den DB-Port zum Host) -- niemals
# auf den Produktivserver uebernehmen. Siehe Kommentar in der Datei selbst.
docker-compose.local-dev.yml

# Node.js
node_modules/
npm-debug.log*

# OS/Editor
.DS_Store
Thumbs.db

# Generierte Backup-Testartefakte (GPG-verschluesselt, aber wiederholt neu
# generierte Binaerdaten -- gehoeren nicht ins Repo, blaehen die Historie auf)
ops/offsite-backup-simulation/

# Ablage der regulaeren, GPG-verschluesselten Voll-DB-Backups (siehe
# ops/backup-db-encrypted.sh) -- wie oben: verschluesselte Binaerdaten,
# gehoeren nicht ins Repo, und muessen ohnehin regelmaessig woanders (offsite)
# abgelegt werden.
ops/db-backups/

# Lokale Rezeptbild-Ablage (AP2.1, projects/wochenplaner-rezeptkarten/plan.md):
# Standard-Fallback von RECIPE_IMAGE_DIR ausserhalb von Docker (server.js).
# Im Docker-Stack zeigt RECIPE_IMAGE_DIR stattdessen auf ein gemountetes
# Volume -- hochgeladene Nutzerbilder gehoeren in keinem Fall ins Repo.
app/data/
