# Kopieren nach .env und ausfuellen:  cp .env.example .env
#
# Beide Geheimnisse erzeugen mit:
#   openssl rand -base64 32

POSTGRES_USER=wochenplan
POSTGRES_PASSWORD=hier-ein-langes-zufallspasswort
POSTGRES_DB=wochenplan

# Passwort der eingeschraenkten Laufzeit-DB-Rolle wochenplan_app (getrennt
# von POSTGRES_PASSWORD/POSTGRES_USER, der Owner-/Migrator-Rolle). Diese
# Rolle ist nicht Tabelleneigentuemerin -- nur ueber sie greifen die
# Row-Level-Security-Policies (Mandantentrennung, siehe AP1.2/AP2.2 in
# projects/wochenplaner-mandantenfaehigkeit/).
WOCHENPLAN_APP_PASSWORD=hier-ein-drittes-langes-zufallspasswort

SESSION_SECRET=hier-ein-zweites-langes-zufallsgeheimnis

# Wo lauscht die Anwendung? Default ist 127.0.0.1 (sicher: nur vom Server
# selbst erreichbar, fuer den Betrieb hinter einem Reverse Proxy).
#   Heimnetz ohne Proxy:  APP_BIND=0.0.0.0   (dann ist Port 3000 im Netz offen)
#   hinter Reverse Proxy: APP_BIND=127.0.0.1  (Standard, nichts eintragen noetig)
APP_BIND=127.0.0.1
APP_PORT=3000

# true setzen, wenn ein Reverse Proxy (Caddy, Traefik, nginx) davor steht.
# Sorgt fuer sichere Cookies und korrekte Client-IPs.
TRUST_PROXY=false

# Nach dem Anlegen der eigenen Konten auf false setzen:
# dann kommen neue Mitglieder nur noch ueber einen Einladungscode hinein.
ALLOW_REGISTRATION=true

# Nur noetig fuer das Proxy-Profil (Zugriff von unterwegs):
DOMAIN=wochenplan.example.org
LETSENCRYPT_MAIL=du@example.org
